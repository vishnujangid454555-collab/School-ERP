# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
ENFORCE_PERMISSIONS=false

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK (Service Account)
# Preferred: point to a JSON key file that is NOT committed to git.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json
# Alternative for hosting providers that only allow env vars (e.g. Render/Railway):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Initial Super Admin bootstrap (used only by the one-time seed script, never hardcoded in app logic)
BOOTSTRAP_SUPER_ADMIN_EMAIL=owner@yourerp.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe_StrongPassword123!
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Owner
